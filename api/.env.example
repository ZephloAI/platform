DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chatbot_saas
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CRAWLER_SERVICE_URL=http://localhost:8001
AGENT_SERVICE_URL=http://localhost:8002

# Resend — transactional email (invites, password reset)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Flunkie <invites@flunkie.ai>
# Optional: Resend template id for the invite email. If empty, a fallback
# HTML body is sent from the api directly.
RESEND_INVITE_TEMPLATE_ID=

# Invite lifecycle
INVITE_EXPIRY_DAYS=7
# Base URL for the accept-invite page in the frontend. The token is
# appended as a path segment: {base}/{token}
INVITE_ACCEPT_URL_BASE=http://localhost/invitations/accept
