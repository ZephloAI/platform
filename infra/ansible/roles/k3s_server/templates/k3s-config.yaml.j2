# K3s server configuration for {{ inventory_hostname }}
# Generated by Ansible - DO NOT EDIT MANUALLY
#
# Cluster topology: 3-node HA with embedded etcd
#   - us-server-1: initializes cluster (--cluster-init)
#   - us-server-2, eu-server-1: join as additional servers (--server)

# Use WireGuard IP for node communication
node-ip: "{{ wireguard_ip }}"

# Flannel uses WireGuard interface for overlay networking
flannel-iface: "{{ wireguard_interface }}"
flannel-backend: "host-gw"

# TLS SANs for API server certificate
tls-san:
  - "{{ ansible_host }}"
  - "{{ wireguard_ip }}"
  - "{{ domain }}"
{% for host in groups['k3s_server'] %}
  - "{{ hostvars[host].wireguard_ip }}"
  - "{{ hostvars[host].ansible_host }}"
{% endfor %}

# Disable built-in components we'll replace with Helm charts
disable:
  - traefik
  - servicelb

# Node labels for topology-aware scheduling
node-label:
  - "topology.kubernetes.io/region={{ node_region }}"
  - "topology.kubernetes.io/zone={{ node_zone }}"

# Cluster networking CIDRs
cluster-cidr: "{{ cluster_cidr }}"
service-cidr: "{{ service_cidr }}"

# Write kubeconfig with correct permissions
write-kubeconfig-mode: "0644"

{% if k3s_init | default(false) %}
# First server - initialize new HA cluster with embedded etcd
cluster-init: true
{% else %}
# Additional server - join existing cluster
server: "{{ k3s_server_url }}"
token: "{{ k3s_token }}"
{% endif %}
