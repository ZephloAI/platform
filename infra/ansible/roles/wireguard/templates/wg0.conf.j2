# WireGuard configuration for {{ inventory_hostname }}
# Generated by Ansible - DO NOT EDIT MANUALLY
#
# IMPORTANT: Each peer gets only its own pod_cidr (/24), NOT the full
# cluster_cidr (/16). Overlapping AllowedIPs causes WireGuard to drop
# routes for all but the last-loaded peer.

[Interface]
PrivateKey = {{ wg_privkey }}
Address = {{ wireguard_ip }}/24
ListenPort = {{ wireguard_port }}
# Prevent MTU issues with encapsulated traffic
MTU = 1420

{% for host in groups['all'] if host != inventory_hostname %}
# Peer: {{ host }} ({{ hostvars[host].node_region }}-{{ hostvars[host].node_zone }})
[Peer]
PublicKey = {{ hostvars[host].wg_pubkey }}
Endpoint = {{ hostvars[host].ansible_host }}:{{ wireguard_port }}
# WireGuard IP + this node's specific pod subnet (NOT the full /16)
AllowedIPs = {{ hostvars[host].wireguard_ip }}/32, {{ hostvars[host].pod_cidr }}
PersistentKeepalive = 25

{% endfor %}
