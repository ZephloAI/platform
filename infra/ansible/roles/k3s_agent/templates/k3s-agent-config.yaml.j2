# K3s agent configuration for {{ inventory_hostname }}
# Generated by Ansible - DO NOT EDIT MANUALLY

# Use WireGuard IP for node communication
node-ip: "{{ wireguard_ip }}"

# Flannel uses WireGuard interface for overlay networking
flannel-iface: "{{ wireguard_interface }}"

# Node labels for topology-aware scheduling
node-label:
  - "topology.kubernetes.io/region={{ node_region }}"
  - "topology.kubernetes.io/zone={{ node_zone }}"
