# OpenRouter API Key (required for chat functionality)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chatbot_saas

# JWT
JWT_SECRET=change-this-to-a-random-secret-in-production

# AWS S3 (for logo uploads)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-s3-bucket-name

# Crawler Settings
MAX_PAGES=50

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Flunkie <invites@flunkie.ai>
RESEND_INVITE_TEMPLATE_ID=
INVITE_EXPIRY_DAYS=7
INVITE_ACCEPT_URL_BASE=http://localhost/invitations/accept
